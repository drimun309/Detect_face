# CPU backend: slim Python + Torch CPU + onnxruntime (без CUDA).
# Образ заметно легче GPU-сборки, инференс только на CPU.
#
# docker build -f dockerfile.cpu.prod -t detect_face-backend:cpu .
# Запуск стека: docker compose -f docker-compose.stack.yaml -f docker-compose.cpu.yaml up -d --build

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_RETRIES=10 \
    YOLO_AUTOINSTALL=False \
    YOLOv5_AUTOINSTALL=False

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.prod.txt /tmp/requirements.txt

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "onnxruntime>=1.17.0,<1.20" \
    && pip install --no-cache-dir ultralytics \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python opencv-contrib-python-headless || true \
    && pip install --no-cache-dir --force-reinstall --no-deps "opencv-python-headless==4.9.0.80" \
    && pip install --no-cache-dir --force-reinstall --no-deps "numpy==1.26.4" \
    && python -c "import cv2, torch; assert hasattr(cv2, 'VideoCapture'); import onnxruntime as ort; print('torch', torch.__version__, 'cuda', torch.cuda.is_available()); print('ort', ort.get_available_providers())" \
    && rm /tmp/requirements.txt

COPY src /app/src
COPY .project-root /app/.project-root

RUN mkdir -p /app/logs /app/tmp /app/data/backend /app/assets

CMD ["python", "src/main.py"]
