# usage: docker build -f dockerfile.gpu.prod -t detect_face-backend:gpu .
# YOLOv8s (.pt) via Ultralytics + CUDA; face ONNX via onnxruntime-gpu.
# Requires NVIDIA Container Toolkit on host.

FROM python:3.10-slim

# install debian dependencies (using Yandex mirror)
RUN DEBIAN_FRONTEND=noninteractive \
    echo 'deb http://mirror.yandex.ru/debian trixie main' > /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl wget ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY ./requirements.gpu.prod.txt /tmp/requirements.txt
ENV PIP_DEFAULT_TIMEOUT=600 PIP_RETRIES=10 PIP_DISABLE_PIP_VERSION_CHECK=1

# Install PyTorch with retry loop (CUDA 12.1 for RTX 30xx series)
RUN pip install --no-cache-dir --upgrade pip && \
    for attempt in 1 2 3 4 5; do \
        pip install --no-cache-dir --retries 5 --timeout 600 torch torchvision --index-url https://download.pytorch.org/whl/cu121 && exit 0 || true; \
    done && exit 1

# Install onnxruntime-gpu with CUDA 12.x support (version must be >=1.19 for CUDA 12.x + cuDNN 9)
RUN pip install --no-cache-dir --retries 5 --timeout 600 "onnxruntime-gpu>=1.19.0" && \
    pip install --no-cache-dir --retries 5 --timeout 600 ultralytics

# Install remaining packages from requirements.txt (use mirror for reliability)
RUN pip install --no-cache-dir --retries 5 --timeout 600 -r /tmp/requirements.txt \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --trusted-host pypi.tuna.tsinghua.edu.cn

RUN rm /tmp/requirements.txt

# Create symlinks for CUDA libraries so onnxruntime-gpu can find them
RUN for dir in /usr/local/lib/python3.10/site-packages/nvidia/*/lib; do \
        if [ -d "$dir" ]; then \
            for lib in "$dir"/*.so*; do \
                if [ -f "$lib" ] && [ ! -L "$lib" ]; then \
                    base=$(basename "$lib" | sed 's/\.[0-9]*$//'); \
                    ln -sf "$(basename $lib)" "$dir/$base.so" 2>/dev/null || true; \
                fi; \
            done; \
        fi; \
    done

COPY . /app
RUN mkdir -p /app/logs /app/tmp /app/data/backend

WORKDIR /app
CMD ["python", "src/main.py"]