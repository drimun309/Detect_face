
# api
API_HOST="0.0.0.0"
API_PORT=7030
SERVER="uvicorn"

# postgres
POSTGRES_HOST="vision-fr-postgres"
POSTGRES_PORT=7031
POSTGRES_USER="didi"
POSTGRES_PASSWORD="didi123"
POSTGRES_DB="vision-fr"

# fr engine (YOLOX + MobileFaceNet)
FR_DET_ENGINE_PATH="assets/yoloxs_face.onnx"
FR_REC_ENGINE_PATH="assets/w600k_mbf.onnx"
# person: yolov8s.pt, crowdhuman_yolov5m.pt (YOLOv5 body+head) or yolo26n.onnx
PERSON_DET_ENGINE_PATH="assets/yolov8s.pt"
FR_DET_MAX_END2END=100
FR_PROVIDER="gpu"

# streaming stack
GO2RTC_CONFIG_PATH="go2rtc/go2rtc.yaml"
GO2RTC_RTSP_URL="rtsp://go2rtc:8554"
MEDIAMTX_URL="rtsp://mediamtx:8554"
ENABLE_ANNOTATED_STREAM=true
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=10
STREAM_FRAME_INTERVAL=2
FR_DET_CONF=0.25
FR_DET_NMS=0.45
FR_DISTANCE=0.5
FR_MIN_DET_SCORE=0.5
EMBEDDING_REFRESH_SEC=30
ROI_TIMER_SWITCH_SEC=60
DETECTION_SETTINGS_PATH=data/backend/detection_settings.json